# ---------------------------------------------------------------------------
# Database
# Local development (Postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opsledger?schema=public"
#
# Supabase: copy the direct connection string (Project settings → Database,
# port 5432, append ?schema=public) into DATABASE_URL. This project uses one
# connection URL for both runtime and migrations, so avoid the 6543
# transaction pooler unless you also add Prisma's directUrl configuration.

# ---------------------------------------------------------------------------
# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# ---------------------------------------------------------------------------
# AI (optional). Without either provider the app stays fully usable;
# quotation entry falls back to the manual editor.
#
# Gemini (primary, recommended)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
#
# Local Ollama (OpenAI-free, runs on your machine). Used only when set and
# Gemini is not configured. Start with: ollama serve
OLLAMA_BASE_URL=""
OLLAMA_MODEL="qwen2.5:3b"

# ---------------------------------------------------------------------------
# Storage. This build ships a local-disk adapter only. STORAGE_DRIVER accepts
# "local"; any other value fails loudly at write time instead of pretending an
# integration exists. Point STORAGE_LOCAL_DIR at a writable path that survives
# restarts (serverless platforms like Vercel do not provide one — see
# docs/vercel.md before enabling document uploads there).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage"
